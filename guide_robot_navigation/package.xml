<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>guide_robot_navigation</name>
  <version>0.0.0</version>
  <description>
    ROS 2 launch scripts for navigation2
  </description>
  <maintainer email="fabian@todo.todo">fabian</maintainer>
  <license>Apache 2.0</license>

  <!-- Плагин контроллера, на который ссылается params/first_iter_nav2.yaml
       (FollowPath.plugin). Загружается по имени в рантайме, поэтому сборка
       без него проходит, а стек падает при конфигурации controller_server. -->
  <exec_depend>nav2_rotation_shim_controller</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
