<?xml version="1.0"?>
<root main_tree_to_execute="NavigateToPose">
<BehaviorTree ID="NavigateToPose">
<!--
  number_of_retries 20 (было 6). Цикл recovery теперь короткий (~5-8 с), и 6
  попыток сгорали бы в толпе за ~40 с, после чего NavigateToPose ABORTED и
  mission FSM молча пропускает остановку (navigating.py _skip_stop). Общий
  предел на переезд держит FSM: nav_stop_timeout_s (mission.yaml, 180 с).
-->
<RecoveryNode number_of_retries="20" name="NavigateRecovery">


  <!--normal navigation-->
  <PipelineSequence name="NavigateWithReplanning">

    <RateController hz="1.0">
      <RecoveryNode number_of_retries="1" name="ComputePathRecovery">
        <ComputePathToPose goal="{goal}" path="{path}" planner_id="GridBased"/>
        <ClearEntireCostmap name="ClearGlobalOnPlanFail"
            service_name="global_costmap/clear_entirely_global_costmap"/>
      </RecoveryNode>
    </RateController>

    <RecoveryNode number_of_retries="1" name="FollowPathRecovery">
      <FollowPath path="{path}" controller_id="FollowPath"/>
      <ClearEntireCostmap name="ClearLocalOnControlFail"
          service_name="local_costmap/clear_entirely_local_costmap"/>
    </RecoveryNode>

  </PipelineSequence>

  <!--
    recovery branch. Робот никуда не едет сам: просит людей отойти, ждёт,
    очищает оба костмапа (отметки ушедших людей) и снова строит маршрут.
    Spin/BackUp убраны (2026-10-31): в толпе они не едут ("Collision Ahead"),
    а только удлиняют цикл; BackUp к тому же сдаёт назад туда, где люди.
    RoundRobin чередует фразы: первая неудача — мягкая просьба, следующая —
    строже, дальше по кругу. Фразы предзаписаны голосом Яндекса громче
    экскурсии (scripts/prerecord_tts.py берёт их отсюда): поменяли текст —
    перезапустить скрипт, иначе фраза уйдёт в облако с обычной громкостью.
  -->
  <ReactiveFallback name="RecoveryFallback">

    <!-- if goal updated ->next tick ──-->
    <GoalUpdated/>

    <RoundRobin name="RecoveryActions">

      <Sequence name="AskToStepAside">
        <SayAction text="Внимание! Пожалуйста, отойдите, роботу нужно проехать." server_name="say"/>
        <Wait wait_duration="3"/>
        <ClearEntireCostmap name="ClearLocalAfterAsk"
            service_name="local_costmap/clear_entirely_local_costmap"/>
        <ClearEntireCostmap name="ClearGlobalAfterAsk"
            service_name="global_costmap/clear_entirely_global_costmap"/>
      </Sequence>

      <Sequence name="InsistToStepAside">
        <SayAction text="Внимание! Робот не может проехать. Пожалуйста, освободите дорогу." server_name="say"/>
        <Wait wait_duration="3"/>
        <ClearEntireCostmap name="ClearLocalAfterInsist"
            service_name="local_costmap/clear_entirely_local_costmap"/>
        <ClearEntireCostmap name="ClearGlobalAfterInsist"
            service_name="global_costmap/clear_entirely_global_costmap"/>
      </Sequence>

    </RoundRobin>
  </ReactiveFallback>

</RecoveryNode>

</BehaviorTree>
</root>
