#pragma once

// Ключ сектора MIFARE (Key A). ОБЯЗАН совпадать с RFID_BRIDGE_SECTOR_KEY
// в ../rfid_bridge/include/rfid_bridge_secrets.h -- иначе карты,
// прошитые этой утилитой, мост не прочитает.
// Источник: ~/.config/guide_robot/rfid_sector_key
#define RFID_SECTOR_KEY \
  { 0x11, 0x22, 0x33, 0x44, 0x55, 0x66 }
