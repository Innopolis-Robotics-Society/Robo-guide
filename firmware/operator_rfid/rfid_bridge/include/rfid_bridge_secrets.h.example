// rfid_bridge_secrets.h.example -- шаблон секретов прошивки (design E4/E5).
//
// НЕ РЕДАКТИРУЙ ВРУЧНУЮ. Файл rfid_bridge_secrets.h генерируется скриптом
// ../tools/gen_secrets.sh из ~/.config/guide_robot/{rfid_secret,rfid_sector_key},
// чтобы значения гарантированно совпадали с тем, что читает узел, и с тем,
// чем прошиваются карты. Расхождение в один символ даёт "карта не читается",
// и искать будешь со стороны антенны.
//
// Этот шаблон -- только документация формата.
// Реальный rfid_bridge_secrets.h в .gitignore, в git не попадает.

#pragma once

// Секрет, продублированный в конфиге узла (config/operator_ui.yaml ->
// rfid_secret_file, вне git) -- HMAC-SHA256(secret, nonce) подписывает
// КАЖДЫЙ ответ ESP. Доказывает узлу, что ответ пришёл от легитимной
// прошивки, а не был инжектирован в serial-линию (design E4: "секрет не
// покидает ESP, наружу уходит только подпись"). 32 случайных байта.
// Источник: ~/.config/guide_robot/rfid_secret
#define RFID_BRIDGE_SHARED_SECRET "REPLACE-ME-64-hex-chars-from-openssl-rand-hex-32"

// Ключ сектора MIFARE (Key A), которым прошиты настоящие карты
// операторов -- НЕ заводской 0xFFFFFFFFFFFF (его знает любой Proxmark и
// любой блокнот в интернете). Карта без этого ключа не аутентифицируется
// вообще -- расценивается как "нет карты", а не читается по UID
// (design E4: "аутентификация карты -- по секрету защищённого сектора,
// не по UID").
//
// ТОТ ЖЕ ключ зашивается в ../card_provision -- иначе прошитые карты не
// прочитаются. Потеря файла с ключом = все прошитые им карты мертвы.
// Источник: ~/.config/guide_robot/rfid_sector_key
#define RFID_BRIDGE_SECTOR_KEY \
  { 0x11, 0x22, 0x33, 0x44, 0x55, 0x66 }

// Серийника USB здесь БОЛЬШЕ НЕТ. Он не секрет (лежит открытым текстом в
// scripts/99-guide-robot-rfid.rules, который коммитится) и задаётся через
// -D USB_SERIAL в platformio.ini. Задать его из setup() невозможно: ядро
// зовёт USB.begin() до setup(), после чего ESPUSB::serialNumber() молча
// возвращает false.
