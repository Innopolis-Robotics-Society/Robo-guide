<?xml version="1.0"?>
<package format="3">
  <name>guide_robot_journal</name><version>0.1.0</version>
  <description>Bounded state/event journal with independent disk writer and complete CDR sensor snapshots.</description>
  <maintainer email="mook@innopolis.university">mook</maintainer><license>Apache-2.0</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>guide_robot_msgs</depend><depend>rclcpp</depend><depend>std_msgs</depend><depend>sensor_msgs</depend>
  <depend>nav_msgs</depend><depend>geometry_msgs</depend><depend>diagnostic_msgs</depend>
  <depend>yaml_cpp_vendor</depend>
  <exec_depend>launch</exec_depend><exec_depend>launch_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <test_depend>ament_cmake_gtest</test_depend>
  <export><build_type>ament_cmake</build_type></export>
</package>
