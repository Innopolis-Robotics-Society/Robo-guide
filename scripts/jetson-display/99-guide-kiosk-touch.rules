# BonXeon IR touch -> HDMI Weston seat, not GNOME on DP-1
ACTION=="add|change", SUBSYSTEM=="input", KERNEL=="event*", ATTRS{idVendor}=="255e", ATTRS{idProduct}=="0001", MODE="0660", GROUP="input", ENV{ID_INPUT}="1", ENV{ID_INPUT_TOUCHSCREEN}="1", ENV{ID_SEAT}="seat-dlhdmi", ENV{LIBINPUT_CALIBRATION_MATRIX}="-1 0 1 0 -1 1", TAG+="seat"
# Панель смонтирована на 180° относительно картинки (weston transform=rotate-90): матрица переворачивает обе оси.
