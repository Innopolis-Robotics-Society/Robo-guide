#!/usr/bin/env python3
"""Control the cursor on the native GNOME face display, independently of ROS.

XFixes hide requests are released when this client's X connection closes.
The HDMI operator panel runs on a separate Weston display and is unaffected.
"""
import ctypes as C
import os
from pathlib import Path
import signal
import time


def cursor_visible(state_dir):
    """Missing/invalid preferences preserve the kiosk's hidden-cursor default."""
    try:
        return (state_dir / "face-cursor-visible").read_text().strip() == "true"
    except (OSError, UnicodeError):
        return False


def open_display(x):
    """Find this user's GNOME X display; systemd retries until login is ready."""
    os.environ.setdefault("XAUTHORITY", f"/run/user/{os.getuid()}/gdm/Xauthority")
    names = [os.environ["DISPLAY"]] if os.environ.get("DISPLAY") else [
        ":" + path.name[1:] for path in sorted(Path("/tmp/.X11-unix").glob("X[0-9]*"))
    ]
    for name in names:
        display = x.XOpenDisplay(name.encode())
        if display:
            print(f"Face cursor display: {name}", flush=True)
            return display
    raise SystemExit("Waiting for GNOME X display")


def main():
    state_dir = Path(os.environ.get("GUIDE_LAUNCHER_STATE_DIR", "~/.guide_robot/launcher")).expanduser()
    x = C.CDLL("libX11.so.6")
    fixes = C.CDLL("libXfixes.so.3")
    window = C.c_ulong
    x.XOpenDisplay.argtypes = [C.c_char_p]
    x.XOpenDisplay.restype = C.c_void_p
    x.XDefaultRootWindow.argtypes = [C.c_void_p]
    x.XDefaultRootWindow.restype = window
    for name in ("XFixesHideCursor", "XFixesShowCursor"):
        getattr(fixes, name).argtypes = [C.c_void_p, window]
    x.XSync.argtypes = [C.c_void_p, C.c_int]
    x.XCloseDisplay.argtypes = [C.c_void_p]
    display = open_display(x)
    root = x.XDefaultRootWindow(display)
    stopped = False
    hidden = False

    def stop(*_):
        nonlocal stopped
        stopped = True

    signal.signal(signal.SIGTERM, stop)
    signal.signal(signal.SIGINT, stop)
    try:
        print("Face cursor control ready", flush=True)
        while not stopped:
            should_hide = not cursor_visible(state_dir)
            if should_hide != hidden:
                (fixes.XFixesHideCursor if should_hide else fixes.XFixesShowCursor)(display, root)
                x.XSync(display, False)
                hidden = should_hide
                print("Face cursor hidden" if hidden else "Face cursor visible", flush=True)
            time.sleep(0.2)
    finally:
        if hidden:
            fixes.XFixesShowCursor(display, root)
            x.XSync(display, False)
        x.XCloseDisplay(display)


if __name__ == "__main__":
    main()
