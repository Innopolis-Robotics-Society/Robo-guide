#!/usr/bin/env python3
"""Fullscreen Wayland kiosk for the HDMI hub. URL from /etc/guide-kiosk/url.

Устанавливается в /usr/local/bin/guide-kiosk-hdmi, запускается
kiosk-hdmi.service (см. README.md рядом).

Почему тут есть повтор загрузки. Киоск стартует вместе с weston на
загрузке, а operator_ui (http://127.0.0.1:8091) поднимают руками и позже.
WebKit грузит URL один раз: если сервера ещё нет, на экране остаётся
страница ошибки, JS страницы (со своим переподключением WebSocket) даже
не загружен, и появление сервера киоск не замечает. Поэтому на
load-failed повторяем загрузку каждые RETRY_S, а если WebKit убил свой
web-процесс -- тоже перезагружаем.
"""

from pathlib import Path
import os

import gi

gi.require_version("Gtk", "3.0")
gi.require_version("Gdk", "3.0")
gi.require_version("WebKit2", "4.1")
from gi.repository import Gdk, GLib, Gtk, WebKit2  # noqa: E402

RETRY_S = 3


def read_url():
    """url-hdmi (только этот киоск), иначе общий url, который читает и лицо."""
    for name in ("url-hdmi", "url"):
        path = Path("/etc/guide-kiosk") / name
        if path.is_file():
            text = path.read_text(encoding="utf-8").strip()
            if text:
                return text
    return "https://www.google.com/"


url = read_url()

win = Gtk.Window()
win.set_title("kiosk")
win.fullscreen()
win.connect("destroy", Gtk.main_quit)


def hide_cursor(window, *_args):
    """Скрыть указатель после создания GDK-окна."""
    gdk_win = window.get_window()
    if gdk_win is not None:
        gdk_win.set_cursor(Gdk.Cursor.new(Gdk.CursorType.BLANK_CURSOR))


win.connect("realize", hide_cursor)

settings = WebKit2.Settings()
settings.set_enable_javascript(True)
settings.set_enable_media(True)
settings.set_enable_media_stream(False)
settings.set_enable_mediasource(True)
settings.set_media_playback_requires_user_gesture(False)
try:
    settings.set_enable_webgl(False)
except Exception:
    pass
wv = WebKit2.WebView()
wv.set_settings(settings)

# A touch-only Weston seat has no keyboard focus, so GTK can leave the
# toplevel inactive even while an HTML input is focused. Bridge editable DOM
# focus to WebKit's own IM context, only for the opt-in text-input-v1 module.
# Messages carry a boolean only: never send field contents/passwords to Python.
if os.environ.get("GTK_IM_MODULE") == "wltextinputv1":
    manager = wv.get_user_content_manager()

    def on_editable_focus(_manager, result):
        value = result.get_js_value()
        if not value.is_boolean():
            return
        context = wv.get_input_method_context()
        if context is None:
            return
        if value.to_boolean():
            context.notify_focus_in()
        else:
            context.notify_focus_out()

    manager.register_script_message_handler("guideEditableFocus")
    manager.connect("script-message-received::guideEditableFocus", on_editable_focus)
    manager.add_script(WebKit2.UserScript.new(
        """(() => {
          let previous = null;
          function update() {
            const el = document.activeElement;
            const editable = !!el && !el.disabled && !el.readOnly && (
              el.isContentEditable || el.tagName === 'TEXTAREA' ||
              (el.tagName === 'INPUT' &&
               /^(text|password|search|email|url|tel|number)$/.test(el.type)));
            if (editable !== previous) {
              previous = editable;
              window.webkit.messageHandlers.guideEditableFocus.postMessage(editable);
            }
          }
          document.addEventListener('focusin', () => setTimeout(update, 0), true);
          document.addEventListener('focusout', () => setTimeout(update, 0), true);
          window.addEventListener('pagehide', () => {
            window.webkit.messageHandlers.guideEditableFocus.postMessage(false);
          });
          update();
        })();""",
        WebKit2.UserContentInjectedFrames.TOP_FRAME,
        WebKit2.UserScriptInjectionTime.END,
        None, None,
    ))

retry_pending = False


def schedule_reload():
    """Запланировать единственную повторную загрузку страницы."""
    global retry_pending
    if retry_pending:
        return
    retry_pending = True

    def _reload():
        global retry_pending
        retry_pending = False
        wv.load_uri(url)
        return False  # одноразовый таймер

    GLib.timeout_add_seconds(RETRY_S, _reload)


def on_load_failed(_wv, _event, failing_uri, error):
    """Повторить загрузку после ошибки главного документа."""
    # Только главный документ: сбой подресурса (картинка, api) сюда не приходит.
    print(
        f"guide-kiosk-hdmi: не загрузился {failing_uri}: {error.message}; "
        f"повтор через {RETRY_S} с",
        flush=True,
    )
    schedule_reload()
    return True  # не показывать стандартную страницу ошибки WebKit


def on_web_process_terminated(_wv, reason):
    """Восстановить страницу после завершения процесса WebKit."""
    print(f"guide-kiosk-hdmi: web-процесс завершился ({reason}); перезагрузка", flush=True)
    schedule_reload()


wv.connect("load-failed", on_load_failed)
wv.connect("web-process-terminated", on_web_process_terminated)
wv.load_uri(url)
win.add(wv)
win.show_all()
Gtk.main()
