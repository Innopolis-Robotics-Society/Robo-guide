# Udev rules for FURO Robot Serial Devices (Orin Nano)
#
# Since the CH341 USB-to-Serial adapters do not have unique serial numbers,
# we distinguish them based on the physical USB port they are plugged into.
#
# Топология с 19.09.2026: CH341 сидят на USB 2.0 хабе (Terminus FE1.1s) вместе с лидарами, хаб --
# в любом из 4 портов Jetson (1-2.N, Realtek-хаб на плате devkit). Ключ -- номер порта НА ХАБЕ,
# а не порт Jetson, поэтому хаб можно переткнуть в другой порт Jetson без правки правил:
#   порт 1 хаба -> моторы, порт 3 или 4 хаба -> сонары (лидары ловятся по серийнику, их порт
#   неважен; CP210x под правила CH341 не попадает по idVendor).
# Сейчас: 1-2.3.1 моторы, 1-2.3.2/1-2.3.3 лидары, 1-2.3.4 сонары. Проверено опросом купола
# сонаров (кадр 0xCC ...). Отдельный хаб 1-2.4, где CH341 стояли сначала, перестал
# энумерировать full-speed устройства (-110/-71) -- списан.
# CH341 не на том порту хаба = нет симлинка = драйвер не стартует (так и задумано: перепутать
# моторы с сонаром хуже, чем не запуститься). Проверка: ls -l /dev/tty_*
# ID_MM_DEVICE_IGNORE: ModemManager не должен слать AT-команды в моторы/лидары (на Jetson он
# ещё и выключен: systemctl disable --now ModemManager).

# 19.09.2026, вечер: внешние хабы (все single-TT) на tegra-xusb виснут (-110) уже на втором
# open/close пары CH341 -- см. guide_robot_bringup/README.md, «Зависание single-TT USB-хаба».
# Поэтому моторы и сонар предпочтительно ПРЯМО в порты Jetson (хаб на плате multi-TT, там они
# отработали сутки без единого сбоя): порт 2 или 3 (1-2.2 / 1-2.3) -> сонар, порт 4 (1-2.4) -> моторы.
# ATTRS{devpath} матчится на самом CH341, так что устройство за хабом (devpath 2.4.1) под
# «прямое» правило не попадает, и наоборот. Вариант с хабом оставлен на случай нехватки портов.
# Раскладка 19.09.2026 вечер: порт 1 -- хаб {левый лидар, микрофон, колонка}; порт 2 -- сонар
# напрямую; порт 3 -- хаб {моторы в порту 1 хаба, FL2000 на 3.0-проходе}; порт 4 -- хаб {правый лидар}.

# Правило простое и физическое: порт 4 Jetson -- моторы (сам CH341 или хаб с ним, любой порт
# хаба), порты 2/3 -- сонар (напрямую или порт 3/4 хаба). Порт 1 -- лидары/аудио. Множества не
# пересекаются, перепутать моторы с сонаром нельзя.

# FURO Sonar controller: прямо в порт 2 или 3 Jetson (1-2.2 / 1-2.3) ...
SUBSYSTEM=="tty", ATTRS{idVendor}=="1a86", ATTRS{idProduct}=="7523", ATTRS{devpath}=="2.[23]", SYMLINK+="tty_sonar", MODE="0666", ENV{ID_MM_DEVICE_IGNORE}="1"
# ... или порт 3/4 хаба, воткнутого в порт 2-3 Jetson (e.g. 1-2.3.4). Хаб в порту 1 -- лидары/аудио
# (там CH340-переходник правого лидара, см. ниже), хаб в порту 4 -- моторный.
SUBSYSTEM=="tty", KERNELS=="1-2.[23].[34]", ATTRS{idVendor}=="1a86", ATTRS{idProduct}=="7523", SYMLINK+="tty_sonar", MODE="0666", ENV{ID_MM_DEVICE_IGNORE}="1"

# FURO Motor controller: прямо в порт 4 Jetson (1-2.4) ...
SUBSYSTEM=="tty", ATTRS{idVendor}=="1a86", ATTRS{idProduct}=="7523", ATTRS{devpath}=="2.4", SYMLINK+="tty_motors", MODE="0666", ENV{ID_MM_DEVICE_IGNORE}="1"
# ... или любой порт хаба, воткнутого в порт 4 Jetson (e.g. 1-2.4.4)
SUBSYSTEM=="tty", KERNELS=="1-2.4.[1-4]", ATTRS{idVendor}=="1a86", ATTRS{idProduct}=="7523", SYMLINK+="tty_motors", MODE="0666", ENV{ID_MM_DEVICE_IGNORE}="1"

# RPLIDAR C1, новые переходники CP2102N с 15.10.2026 -- ловятся по серийнику переходника, порт
# неважен. Сторона проверена отключением: левый лидар (S/N B6B3...) -- переходник 0a89..., правый
# (S/N 70B3...) -- 9a3c.... Прежние переходники (CP2102 "LIDAR", CH340 на 1-2.1.4, CP2102 "0001")
# сняты, их правила удалены: иначе заменённый переходник молча получил бы чужую сторону.
SUBSYSTEM=="tty", ATTRS{idVendor}=="10c4", ATTRS{idProduct}=="ea60", ATTRS{serial}=="0a8936a0251ef11181f8c6e40f0f12f8", SYMLINK+="tty_lidar_left", MODE="0666", ENV{ID_MM_DEVICE_IGNORE}="1"
SUBSYSTEM=="tty", ATTRS{idVendor}=="10c4", ATTRS{idProduct}=="ea60", ATTRS{serial}=="9a3c0045191ef111b20bc6e40f0f12f8", SYMLINK+="tty_lidar_right", MODE="0666", ENV{ID_MM_DEVICE_IGNORE}="1"
