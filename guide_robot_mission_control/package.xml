<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>guide_robot_mission_control</name>
  <version>0.1.0</version>
  <description>
    Владелец состояния тура: FSM, стек прерываний, резюмирование нарратива.
    Водит guide_robot_voice (Say) и guide_robot_semantic_map (контент,
    маршруты, туры) через их action/srv интерфейсы; сам речь не синтезирует
    и текст не пишет.
  </description>
  <maintainer email="mook@innopolis.university">Mook</maintainer>
  <license>Apache-2.0</license>

  <depend>rclpy</depend>
  <depend>lifecycle_msgs</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>action_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>nav2_msgs</depend>
  <depend>guide_robot_msgs</depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>nav2_lifecycle_manager</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>python3-pytest</test_depend>
  <test_depend>rosgraph_msgs</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
