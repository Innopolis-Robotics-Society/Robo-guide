<?xml version="1.0"?>
<!-- =========================================================================
     ros2_control interface for Guide robot.

     Three hardware backends, priority top to bottom:
       use_sim=true           -> Gazebo Classic (gazebo_ros2_control)
       use_mock_hardware=true -> mock_components stub for stack testing
       otherwise              -> real Dynamixel base driver (FURO)

     NOT standalone-processable: relies on properties declared by
     guide_robot.urdf.xacro before the include point - p, wheel_separation,
     wheel_radius. Process the main xacro, not this file.

     IMPORTANT: comments MUST stay ASCII-only (see note in guide_robot.urdf.xacro).
     ========================================================================= -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:arg name="use_sim"           default="false"/>
  <xacro:arg name="use_mock_hardware" default="false"/>

  <xacro:property name="lim" value="${p['limits']}"/>
  <xacro:property name="drv" value="${p['drive']}"/>

  <!-- Per-wheel command envelope. Worst case is full linear PLUS full angular
       applied at once:
         v_wheel = v_max + w_max * wheel_separation / 2
         w_wheel = v_wheel / wheel_radius * wheel_limit_margin
       With the current robot_params.yaml this evaluates to 8.38 rad/s.
       This is an ENVELOPE, not a limit: actual clamping is done by
       diff_drive_controller. Too narrow drops commands, too wide is harmless,
       hence the margin. Recomputed automatically - do not hardcode. -->
  <xacro:property name="w_wheel_max"
    value="${((lim['max_linear_velocity'] + lim['max_angular_velocity']*wheel_separation/2)
              / wheel_radius * lim['wheel_limit_margin'])}"/>

  <xacro:macro name="wheel_iface" params="name">
    <joint name="${name}">
      <command_interface name="velocity">
        <param name="min">${-w_wheel_max}</param>   <!-- rad/s -->
        <param name="max">${w_wheel_max}</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
  </xacro:macro>

  <ros2_control name="GuideRobotSystem" type="system">

    <hardware>
      <xacro:if value="$(arg use_sim)">
        <!-- Gazebo Classic: simulated hardware via gazebo_ros2_control.
             Drives the same velocity interfaces as the real base. -->
        <plugin>gazebo_ros2_control/GazeboSystem</plugin>
      </xacro:if>
      <xacro:unless value="$(arg use_sim)">
        <xacro:if value="$(arg use_mock_hardware)">
          <!-- Stub for running the full stack without real hardware. -->
          <plugin>mock_components/GenericSystem</plugin>
          <param name="calculate_dynamics">true</param>
        </xacro:if>
        <xacro:unless value="$(arg use_mock_hardware)">
          <!-- Real FURO Dynamixel base driver. All values come from
               config/robot_params.yaml, section 'drive' - see that file for
               measurement provenance. -->
          <plugin>guide_robot_hardware/GuideRobotSystem</plugin>
          <param name="serial_port">${drv['serial_port']}</param>
          <param name="baud_rate">${drv['baud_rate']}</param>
          <param name="left_wheel_id">${drv['left_wheel_id']}</param>
          <param name="right_wheel_id">${drv['right_wheel_id']}</param>
          <param name="ticks_per_rev">${drv['ticks_per_rev']}</param>
          <param name="left_sign">${drv['left_sign']}</param>
          <param name="right_sign">${drv['right_sign']}</param>
          <param name="swap_drives">${drv['swap_drives']}</param>
          <param name="speed_coefficient">${drv['speed_coefficient']}</param>
          <param name="wheel_radius">${wheel_radius}</param>
          <param name="cmd_timeout">${drv['cmd_timeout']}</param>
        </xacro:unless>
      </xacro:unless>
    </hardware>

    <xacro:wheel_iface name="left_wheel_joint"/>
    <xacro:wheel_iface name="right_wheel_joint"/>

  </ros2_control>

</robot>