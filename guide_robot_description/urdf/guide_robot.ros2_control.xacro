<?xml version="1.0"?>
<!-- =========================================================================
     ros2_control interface for Guide robot.

     Three hardware backends, priority top to bottom:
       use_sim=true           -> Gazebo Classic (gazebo_ros2_control)
       use_mock_hardware=true -> mock_components stub for stack testing
       otherwise              -> real Dynamixel base driver (FURO)

     IMPORTANT: comments MUST stay ASCII-only (see note in guide_robot.urdf.xacro).
     ========================================================================= -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:arg name="use_sim"           default="false"/>
  <xacro:arg name="use_mock_hardware" default="false"/>

  <ros2_control name="GuideRobotSystem" type="system">

    <hardware>
      <xacro:if value="$(arg use_sim)">
        <!-- Gazebo Classic: simulated hardware via gazebo_ros2_control.
             Drives the same velocity interfaces as the real base. -->
        <plugin>gazebo_ros2_control/GazeboSystem</plugin>
      </xacro:if>
      <xacro:unless value="$(arg use_sim)">
        <xacro:if value="$(arg use_mock_hardware)">
          <!-- Stub for running the full stack without real hardware. -->
          <plugin>mock_components/GenericSystem</plugin>
          <param name="calculate_dynamics">true</param>
        </xacro:if>
        <xacro:unless value="$(arg use_mock_hardware)">
          <!-- Real FURO Dynamixel base driver. -->
          <plugin>guide_robot_hardware/GuideRobotSystem</plugin>
          <param name="serial_port">/dev/tty_motors</param>      <!-- udev symlink, see scripts/99-furo-devices.rules -->
          <param name="baud_rate">115200</param>
          <param name="left_wheel_id">46</param>                 <!-- 0x2E -->
          <param name="right_wheel_id">47</param>                <!-- 0x2F -->
          <param name="ticks_per_rev">131072</param>             <!-- 512*4*64, quadrature is x4 not x8 (measured) -->
          <param name="left_sign">1</param>
          <param name="right_sign">-1</param>                    <!-- right wheel inverted physically -->
          <param name="swap_drives">1</param>                    <!-- FURO_SWAP_DRIVES -->
          <param name="speed_coefficient">0.0001706</param>      <!-- m/s per motor unit, measured (2026-07-26): cmd 0.2 m/s -> odom avg 0.0426 m/s over 3 runs -->
          <param name="wheel_radius">0.1026</param>              <!-- rolling radius, measured: 3.157 m over 30.758 rad -->
          <param name="cmd_timeout">0.3</param>                  <!-- watchdog, seconds -->
        </xacro:unless>
      </xacro:unless>
    </hardware>

    <!-- Per-wheel envelope must cover the WORST CASE of the base limits in
         guide_robot_controllers.yaml, which is full linear PLUS full angular:
           v_wheel = v_max + w_max * wheel_separation_eff / 2
                   = 0.6 + 1.0472 * 0.35597 / 2 = 0.7864 m/s
           w_wheel = 0.7864 / 0.1026 = 7.66 rad/s
         The old 6.98 was below that after the 2026-07-27 speed doubling, so a
         simultaneous drive+turn at full command would have sat outside the
         declared range. Raised to 8.0 rad/s (0.82 m/s) to keep margin.
         Recompute this whenever the yaml limits or wheel_radius change. -->
    <!-- Left wheel -->
    <joint name="left_wheel_joint">
      <command_interface name="velocity">
        <param name="min">-8.0</param>   <!-- rad/s -->
        <param name="max">8.0</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <!-- Right wheel -->
    <joint name="right_wheel_joint">
      <command_interface name="velocity">
        <param name="min">-8.0</param>
        <param name="max">8.0</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

  </ros2_control>

</robot>
