controller_manager:
  ros__parameters:
    update_rate: ${controller_manager.update_rate}

    joint_state_broadcaster:
      type: joint_state_broadcaster/JointStateBroadcaster

    diff_drive_controller:
      type: diff_drive_controller/DiffDriveController
    # TEMPORARY WORKAROUND / ВРЕМЕННОЕ РЕШЕНИЕ:
    # Изначально компонент планировался в 'unconfigured', чтобы supervisor управлял
    # активацией hardware. До завершения интеграции supervisor с ros2_control
    # держим 'active', чтобы спавнеры и контроллеры поднимались автоматически.
    hardware_components_initial_state:
      active:
        - GuideRobotSystem

joint_state_broadcaster:
  ros__parameters:
    joints: [left_wheel_joint, right_wheel_joint]

diff_drive_controller:
  ros__parameters:
    left_wheel_names:  [left_wheel_joint]
    right_wheel_names: [right_wheel_joint]

    # Геометрическая колея - та же, что в URDF, по построению.
    # Калибровка одометрии сидит в множителе ниже, см. секцию odometry
    # в robot_params.yaml. Линейный масштаб задаётся ТОЛЬКО парой
    # wheel_radius/ticks_per_rev, причём зависит лишь от их ОТНОШЕНИЯ.
    wheel_separation: ${geometry.wheel_separation}
    wheel_radius: ${geometry.wheel_radius}

    # Множители тюнятся в рантайме через ros2 param set без пересборки;
    # подобранное значение переносить в robot_params.yaml.
    wheel_separation_multiplier: ${odometry.wheel_separation_multiplier}
    left_wheel_radius_multiplier: ${odometry.left_wheel_radius_multiplier}
    right_wheel_radius_multiplier: ${odometry.right_wheel_radius_multiplier}

    publish_rate: ${controller_manager.publish_rate}
    odom_frame_id: odom
    base_frame_id: base_footprint
    cmd_vel_timeout: 0.5
    use_stamped_vel: false

    # has_velocity_limits/has_acceleration_limits ОБЯЗАТЕЛЬНЫ. Здесь стояло, что
    # они deprecated и "NaN = лимит выключен" -- для установленной сборки это
    # неверно: speed_limiter.hpp объявляет SpeedLimiter(bool has_velocity_limits
    # = false, bool has_acceleration_limits = false, ...), и на живом роботе оба
    # параметра читались как False. То есть все числа ниже были мёртвыми, а
    # ступенька от collision_monitor уходила на мотор как есть (-15.5 м/с^2 за
    # кадр по бэгу 2026-08-10). Это единственная ступень, способная сгладить
    # срез монитора: velocity_smoother стоит ДО него.
    #
    # ЗАМЕДЛЕНИЕ ЗАДАЁТСЯ ЧЕРЕЗ min_acceleration, НЕ max_deceleration. В
    # /opt/ros/humble (Humble-ветка diff_drive_controller) параметра
    # *_deceleration нет вообще: в diff_drive_controller_parameters.hpp и в
    # strings libdiff_drive_controller.so есть только min_acceleration /
    # max_acceleration. max_deceleration тихо проглатывается как неизвестный
    # override, а min_acceleration остаётся NaN -- конструктор SpeedLimiter в
    # этом случае подставляет -max_acceleration. По бэгу fp_FINAL так и вышло:
    # лимитер заработал (p95 |a| 6.8 -> 1.0 м/с^2), но тормоз был 0.6, а не 1.5,
    # и остановка растянулась на ~1.4 с.
    #
    # Эти же числа читают velocity_smoother и DWB - через тот же шаблонизатор,
    # кроме min_acceleration: там намеренно жёсткий предел (см. robot_params).
    linear.x.has_velocity_limits: true
    linear.x.has_acceleration_limits: true
    linear.x.max_velocity: ${limits.max_linear_velocity}
    linear.x.min_velocity: -${limits.max_linear_velocity}
    linear.x.max_acceleration: ${limits.max_linear_accel}
    linear.x.min_acceleration: -${limits.max_linear_decel_hard}

    angular.z.has_velocity_limits: true
    angular.z.has_acceleration_limits: true
    angular.z.max_velocity: ${limits.max_angular_velocity}
    angular.z.min_velocity: -${limits.max_angular_velocity}
    angular.z.max_acceleration: ${limits.max_angular_accel}
    angular.z.min_acceleration: -${limits.max_angular_decel}
