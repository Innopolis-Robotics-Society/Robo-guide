<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>guide_robot_llm</name>
  <version>0.1.0</version>
  <description>
    ЛЛМ-агент робота-экскурсовода: tool_broker держит клиентов к
    mission_fsm/semantic_map/voice и валидирует/гейтит вызовы инструментов
    по текущему /mission/state; dialog_agent поверх него ведёт ReAct
    tool-calling цикл (~/call_tool); interaction_log пишет jsonl-лог ходов.
    См. README.md/llm_plam.md.
  </description>
  <maintainer email="mook@innopolis.university">Mook</maintainer>
  <license>Apache-2.0</license>

  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>diagnostic_msgs</depend>
  <depend>action_msgs</depend>
  <depend>guide_robot_msgs</depend>
  <depend>lifecycle_msgs</depend>
  <depend>python3-requests</depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>nav2_lifecycle_manager</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>python3-pytest</test_depend>
  <test_depend>guide_robot_mission_control</test_depend>
  <test_depend>nav2_msgs</test_depend>
  <test_depend>rosgraph_msgs</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
