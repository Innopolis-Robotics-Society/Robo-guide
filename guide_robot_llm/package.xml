<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>guide_robot_llm</name>
  <version>0.1.0</version>
  <description>
    Голосовой чат с LLM робота-экскурсовода: замыкает
    /asr/transcript -&gt; LLM -&gt; say поверх контракта guide_robot_voice.
    О туре и об экспонатах пакет не знает ничего -- это Stage 0,
    отладочный "LLM без тура".
  </description>
  <maintainer email="mook@innopolis.university">Mook</maintainer>
  <license>Apache-2.0</license>

  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>diagnostic_msgs</depend>
  <depend>action_msgs</depend>
  <depend>guide_robot_msgs</depend>
  <depend>lifecycle_msgs</depend>
  <depend>python3-requests</depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>nav2_lifecycle_manager</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
