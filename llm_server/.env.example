# Скопировать в .env: `cp .env.example .env`, затем скачать модель `scripts/fetch_model.sh`.
# .env в git не попадает (см. .gitignore).

# --- Образ ---
# Тег обязателен, дефолта в docker-compose.yml нет намеренно (падает с понятной ошибкой).
# CPU-смоук (шаг 1 из SPEC, без GPU): server
# Боевой режим (GPU):                 server-cuda
LLAMA_TAG=server-cuda

# --- Сеть ---
# 127.0.0.1 = симулятор на этом же ноуте, 0.0.0.0 = раздача на Jetson по Wi-Fi.
# Внутри контейнера LLAMA_ARG_HOST всегда 0.0.0.0 — это переключатель публикации порта хоста.
LLM_BIND=127.0.0.1
LLM_PORT=8080

# --- Модель ---
# Значения ниже — профиль qwen7b-q4 (дефолт для ноута, см. config/models/qwen7b-q4.env).
# Чтобы сменить профиль — скопировать нужные строки из config/models/<profile>.env поверх этих.
MODELS_DIR=./models
MODEL_FILE=Qwen2.5-7B-Instruct-Q4_K_M.gguf
MODEL_ALIAS=qwen2.5-7b-instruct-q4_k_m

# --- Тюнинг llama-server (обоснования — README.md и SPEC §2) ---
CTX_SIZE=16384
N_GPU_LAYERS=999
N_PARALLEL=1
BATCH=2048
UBATCH=512
FLASH_ATTN=on
CACHE_REUSE=256

# --- Безопасность ---
# Пусто = без авторизации. Задавать обязательно, если порт пробрасывается за пределы localhost.
LLM_API_KEY=

# --- scripts/fetch_model.sh ---
# Нужен только для моделей за gated-доступом на HF; для открытых репозиториев не требуется.
HF_TOKEN=

# --- сервис llm-warmup ---
CURL_TAG=8.11.1
WARMUP_TIMEOUT_S=600
