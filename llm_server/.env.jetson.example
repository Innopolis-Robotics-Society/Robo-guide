# Jetson-профиль. Скопировать в .env: `cp .env.jetson.example .env`, затем
# ./scripts/fetch_model.sh (см. профиль модели), собрать образ
# (docker/Dockerfile.jetson) и поднять:
#
#   docker compose -f docker-compose.yml -f docker-compose.jetson.yml up -d llm
#
# ПЕРЕД первым запуском — задача 1 из iros_llm_server_JETSON_UPDATE.md
# (scripts/cudamalloc_probe.sh) обязана пройти 3 GB на этом же железе.
# Если не проходит -- остальное здесь не имеет смысла.
#
# .env в git не попадает (см. .gitignore).

# --- Образ ---
# Собственная сборка из docker/Dockerfile.jetson (upstream server-cuda не
# подходит под Tegra, см. JETSON_UPDATE.md задача 3). LLAMA_REF обязан
# совпадать с версией, зашитой в LLAMA_TAG x86-профиля -- сверять вручную
# при обновлении любого из профилей.
LLAMA_REF=

# --- Сеть ---
# Потребитель — локальный ROS-стек на том же Jetson, порт наружу не нужен.
LLM_BIND=127.0.0.1
LLM_PORT=8080

# --- Модель ---
# Начать с jetson-qwen2.5-1.5b (см. config/models/), НЕ с 3B/7B — общий пул
# памяти с ROS-стеком (7.4 GB total, unified). Профиль ниже -- дефолт-пример,
# скопировать нужные строки из config/models/jetson-*.env поверх этих.
MODELS_DIR=./models
MODEL_FILE=Qwen2.5-1.5B-Instruct-Q4_K_M.gguf
MODEL_ALIAS=qwen2.5-1.5b-instruct-q4_k_m

# --- Тюнинг llama-server: дельта к x86, см. JETSON_UPDATE.md задача 5 ---
# CTX_SIZE вниз с 16384 до 2048 -- KV-кэш линеен по контексту, а память
# общая с ROS (не выделенная VRAM, как на ноуте).
CTX_SIZE=2048
# BATCH/UBATCH вниз с 2048/512 -- compute-буферы префилла берутся из того
# же общего пула памяти.
BATCH=512
UBATCH=128
N_GPU_LAYERS=999
N_PARALLEL=1
FLASH_ATTN=on
CACHE_REUSE=256
# q8_0 требует FLASH_ATTN=on (выше). Даёт ~2x экономии памяти под KV-кэш
# ценой точности -- на 2048 токенах контекста деградация вкуса ответа
# не проверялась, только объём памяти.
CACHE_TYPE_K=q8_0
CACHE_TYPE_V=q8_0
# Открытый вопрос (не решён здесь, см. JETSON_UPDATE.md): гипотеза, что при
# mmap page cache мешает непрерывной cudaMalloc-аллокации весов на Tegra.
# Дефолт 0 = поведение как на x86. Снять обе ветки замером
# (scripts/mem_probe.sh + scripts/bench_ttft.py) перед тем как менять на 1.
NO_MMAP=0

# --mlock сознательно НЕ используется на Jetson (повышает риск OOM для
# ROS-стека) -- в .env отсутствует, потому что docker-compose.yml не
# прокидывает LLAMA_ARG_MLOCK вовсе (ни на x86, ни здесь).

# --- Безопасность ---
LLM_API_KEY=

# --- scripts/fetch_model.sh ---
HF_TOKEN=

# --- сервис llm-warmup ---
# Не используется на Jetson: docker-compose.jetson.yml поднимает только
# сервис `llm`, прогрев встроен в docker/entrypoint.jetson.sh. Переменные
# ниже читает entrypoint внутри контейнера напрямую (не llm-warmup сайдкар).
WARMUP_TIMEOUT_S=600
