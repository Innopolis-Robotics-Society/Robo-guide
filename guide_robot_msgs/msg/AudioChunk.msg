# Кадр PCM с фронтенда.
#
# ВРЕМЕННЫЙ транспорт периода разработки. После переезда фронтенда,
# VAD и wakeword в один C++ контейнер этот топик исчезает: обмен идёт
# по intra-process ring buffer без сериализации. Контракт наружу
# (/asr/, /speech/) при этом не меняется.

std_msgs/Header header

uint32 sample_rate
uint16 channels

# int16 little-endian, interleaved.
int16[] data

# Монотонный индекс первого сэмпла кадра от старта потока. Разрыв
# в последовательности означает пропуск буфера -- для AEC это скачок
# задержки, то есть расхождение фильтра. Логируется как ошибка.
uint64 first_sample
