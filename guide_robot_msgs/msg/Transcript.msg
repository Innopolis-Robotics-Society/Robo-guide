# Результат распознавания речи.
#
# Публикуется на двух топиках с разной QoS:
#   /asr/partial     BEST_EFFORT, depth 1   -- волатильные гипотезы, 5-10 Гц
#   /asr/transcript  RELIABLE,    depth 10  -- финальные, потеря недопустима
#
# is_final различает их содержательно; топики -- транспортно.

std_msgs/Header header

# Монотонный идентификатор высказывания. Все партиалы одного высказывания
# и его финал несут одинаковый utterance_id -- по нему потребитель склеивает
# поток и понимает, что новая гипотеза заменяет старую, а не добавляется.
uint64 utterance_id

string text
bool is_final

# Средняя уверенность по высказыванию, [0..1]. -1.0 если бэкенд не отдаёт.
float32 confidence

# Границы речи относительно начала высказывания, сек.
float32 speech_start
float32 speech_end

# BCP-47, например "ru" или "en".
string language

# Азимут источника на момент начала высказывания, рад, кадр mic_array.
# NaN если DoA недоступен. Нужен, чтобы связать реплику с конкретным
# посетителем в группе.
float32 azimuth
